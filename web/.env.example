# =====================================================================
#  APPLICATION SETTINGS (.env.example)
#  ---------------------------------------------------------------------
#  Setup: copy this file to ".env" then fill in the values marked
#         ">>> CHANGE" below. Run "php artisan key:generate" after.
#  =====================================================================

# >>> CHANGE: your store name (shown in the browser tab / welcome page) <<<
APP_NAME=DigitalStore

# >>> KEEP "production" once the site is live. <<<
APP_ENV=production

# >>> DO NOT change. Generated with: php artisan key:generate <<<
APP_KEY=

# >>> KEEP "false" in production. "true" shows crash details to visitors <<<
APP_DEBUG=false

# >>> CHANGE: your full domain, WITH https, NO trailing slash.
#     Example: https://yourstore.com   <<<
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# >>> Keep (do not touch normally) <<<
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =====================================================================
#  DATABASE - set these to the values your hosting gave you (phpMyAdmin)
# =====================================================================
DB_CONNECTION=mysql
# >>> CHANGE: usually "localhost" on shared hosting <<<
DB_HOST=127.0.0.1
DB_PORT=3306
# >>> CHANGE: the database name you created on the host <<<
DB_DATABASE=digital
# >>> CHANGE: the database user you created on the host <<<
DB_USERNAME=root
# >>> CHANGE: the strong database password you set on the host <<<
DB_PASSWORD=

# =====================================================================
#  SESSIONS & COOKIES
# =====================================================================
# >>> Keep "database" <<<
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# >>> Keep EMPTY (null) unless www and non-www must share logins <<<
SESSION_DOMAIN=null
# >>> Set to "true" in production so the login cookie only travels over HTTPS <<<
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# >>> Keep "database" <<<
QUEUE_CONNECTION=database

# >>> Keep "database" <<<
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =====================================================================
#  EMAIL - this store delivers products MANUALLY (admin emails the file),
#  so no real SMTP is needed. You may leave these as they are.
# =====================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# >>> OPTIONAL: change to your FROM address if you later enable email <<<
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"